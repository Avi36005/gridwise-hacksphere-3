# Copy to .env (git-ignored). The app, predict.py, and scripts/build_appsail.sh read it;
# variables already set in the process environment take precedence.

# local | quickml | api. Unset: the server uses local; predict.py uses quickml when the
# credentials below are complete, otherwise api (the deployed app calls QuickML for it).
# MODEL_PROVIDER=quickml

# Secrets for the published QuickML endpoints (never commit real values). The CatBoost key is
# required; with the linear key too, forecasts are the average of both models.
QUICKML_ENDPOINT_KEY=
QUICKML_LINEAR_ENDPOINT_KEY=
# Zoho self client (api-console.zoho.in), scope QuickML.deployment.READ.
QUICKML_CLIENT_ID=
QUICKML_CLIENT_SECRET=
# One-time grant code; scripts/exchange_quickml_code.py swaps it for QUICKML_REFRESH_TOKEN.
QUICKML_AUTH_CODE=
QUICKML_REFRESH_TOKEN=

# Non-secret overrides; defaults point at the published Gridwise endpoint (IN data center).
# QUICKML_ENDPOINT_URL=https://api.catalyst.zoho.in/quickml/v1/project/102738000000013053/endpoints/predict
# QUICKML_ORG_ID=60093139810
# QUICKML_ENVIRONMENT=Development
# QUICKML_MODEL_NAME=CatBoost regression
# QUICKML_LINEAR_MODEL_NAME=Linear regression (QuickML)
# QUICKML_BATCH_SIZE=200
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# GRIDWISE_API_URL=https://gridwise-50047143069.development.catalystappsail.in
