# Variables are read from the process environment, not automatically from this file.
MODEL_PROVIDER=local
PORT=8000
HOST=127.0.0.1

# Required for the hackathon submission after training/publishing in QuickML:
# MODEL_PROVIDER=quickml
QUICKML_ENDPOINT_URL=
QUICKML_ACCESS_TOKEN=
QUICKML_ENDPOINT_KEY=
QUICKML_ORG_ID=
QUICKML_ENVIRONMENT=Development
QUICKML_MODEL_NAME=LightGBM regression

# Match these to the published endpoint's input and Test response.
# engineered uses the same numeric columns as reports/quickml_training_features.csv.
# raw sends timestamp plus the three weather inputs.
QUICKML_FEATURE_MODE=engineered
QUICKML_REQUEST_KEY=data
QUICKML_RESPONSE_PATH=predictions
QUICKML_TARGET_KEY=target_demand_kw
